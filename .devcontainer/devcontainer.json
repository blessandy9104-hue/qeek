{
  "name": "zoveli-ai",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "postCreateCommand": "bash -lc 'npm install -g pnpm@11.7.0 && pnpm install'",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "dbaeumer.vscode-icons",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.vscode"
      ]
    }
  }
}
