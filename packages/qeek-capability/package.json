{
  "name": "@qeek/qeek-capability",
  "version": "0.1.0",
  "description": "qeek Capability Awareness System - Dynamic capability discovery, introspection, and adaptation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./scanner": {
      "types": "./dist/scanner.d.ts",
      "import": "./dist/scanner.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./adaptation": {
      "types": "./dist/adaptation.d.ts",
      "import": "./dist/adaptation.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "oxlint",
    "clean": "rm -rf dist",
    "scan": "tsx src/scanner.ts",
    "report": "tsx src/report.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-core": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "oxlint": "catalog:",
    "tsx": "^4.7.0"
  }
}