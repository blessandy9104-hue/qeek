{
  "name": "@qeek/qeek-host",
  "version": "0.1.0",
  "description": "Minimal local host for qeek plugins: loader, tool registry, REPL, and optional LLM chat",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "oxlint",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@deepseek-ai/dsh-core": "workspace:*",
    "@personal-assistant/assistant-core": "workspace:*",
    "@personal-assistant/assistant-math": "workspace:*",
    "@personal-assistant/assistant-memory": "workspace:*",
    "@personal-assistant/assistant-skills": "workspace:*",
    "@qeek/qeek-languages": "workspace:*",
    "@qeek/qeek-sysinfo": "workspace:*",
    "@qeek/qeek-search": "workspace:*",
    "@qeek/qeek-scheduler": "workspace:*",
    "@qeek/qeek-secscan": "workspace:*",
    "@qeek/qeek-health": "workspace:*",
    "@qeek/qeek-graph": "workspace:*",
    "@qeek/qeek-docgen": "workspace:*",
    "@qeek/qeek-code-analysis": "workspace:*",
    "@qeek/qeek-capability": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "^0.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "oxlint": "catalog:",
    "@types/node": "^20.10.0"
  }
}
