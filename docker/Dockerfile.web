# Syntax: Dockerfile
# qeek web image: HTTP API + UI on :3080 with /health.
# NOTE: node:22 minimum — pnpm 11 requires node:sqlite (Node 22.5+).
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm (must match packageManager in package.json)
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

# Copy source (.dockerignore keeps node_modules/dist/.git out).
# Single COPY keeps all 60 workspace manifests aligned with sources.
COPY . .

# Install dependencies
RUN pnpm install --frozen-lockfile --prod=false

# Build all packages (tsc emit)
RUN pnpm run build

# Runtime stage
FROM node:22-alpine AS runtime

WORKDIR /app

# Install dumb-init
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 1000 -S qeek && \
    adduser -u 1000 -S qeek -G qeek

# Copy built artifacts (workspace symlinks in node_modules resolve into packages/)
COPY --from=builder --chown=qeek:qeek /app/package.json ./
COPY --from=builder --chown=qeek:qeek /app/pnpm-lock.yaml ./
COPY --from=builder --chown=qeek:qeek /app/node_modules ./node_modules
COPY --from=builder --chown=qeek:qeek /app/packages ./packages
COPY --from=builder --chown=qeek:qeek /app/apps/assistant-web/package.json ./apps/assistant-web/package.json
COPY --from=builder --chown=qeek:qeek /app/apps/assistant-web/dist ./apps/assistant-web/dist
COPY --from=builder --chown=qeek:qeek /app/knowledge-vault ./knowledge-vault

# Create directories
RUN mkdir -p /app/data/vault /app/data/sessions /app/data/audit && \
    chown -R qeek:qeek /app/data

# Switch to non-root user
USER qeek

# Environment
ENV NODE_ENV=production
ENV PORT=3080
ENV ASSISTANT_VAULT_PATH=/app/data/vault
ENV MATHCORE_AUDIT=/app/data/audit/audit.jsonl
ENV ASSISTANT_SESSION_PATH=/app/data/sessions

# Expose port
EXPOSE 3080

# Health check (served by apps/assistant-web)
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3080/health', (r) => {if(r.statusCode!==200) process.exit(1)})" || exit 1

# Entry point
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/assistant-web/dist/server.js"]
