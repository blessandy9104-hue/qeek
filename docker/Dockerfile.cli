# Syntax: Dockerfile
# qeek CLI image: offline-capable assistant console.
# Run interactively: docker run --rm -i qeek-cli
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm (must match packageManager in package.json)
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

# Copy workspace manifests first for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/*/package.json ./packages/*/
COPY apps/*/package.json ./apps/*/

# Install dependencies
RUN pnpm install --frozen-lockfile --prod=false

# Copy source
COPY . .

# Build all packages (tsc emit)
RUN pnpm run build

# Runtime stage
FROM node:20-alpine AS runtime

WORKDIR /app

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init

# Create non-root user
RUN addgroup -g 1000 -S qeek && \
    adduser -u 1000 -S qeek -G qeek

# Copy built artifacts (workspace symlinks in node_modules resolve into packages/)
COPY --from=builder --chown=qeek:qeek /app/package.json ./
COPY --from=builder --chown=qeek:qeek /app/pnpm-lock.yaml ./
COPY --from=builder --chown=qeek:qeek /app/node_modules ./node_modules
COPY --from=builder --chown=qeek:qeek /app/packages ./packages
COPY --from=builder --chown=qeek:qeek /app/apps/assistant-cli/package.json ./apps/assistant-cli/package.json
COPY --from=builder --chown=qeek:qeek /app/apps/assistant-cli/dist ./apps/assistant-cli/dist
COPY --from=builder --chown=qeek:qeek /app/knowledge-vault ./knowledge-vault

# Create directories
RUN mkdir -p /app/data/vault /app/data/sessions /app/data/audit && \
    chown -R qeek:qeek /app/data

# Switch to non-root user
USER qeek

# Environment
ENV NODE_ENV=production
ENV ASSISTANT_VAULT_PATH=/app/data/vault
ENV MATHCORE_AUDIT=/app/data/audit/audit.jsonl
ENV ASSISTANT_SESSION_PATH=/app/data/sessions

# NOTE: no HEALTHCHECK — the CLI is interactive, not a service.
# mathcore verified-math needs the mathcore-mcp binary on PATH;
# install python + mathcore in a derived image to enable it.

# Entry point
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/assistant-cli/dist/cli.js"]
